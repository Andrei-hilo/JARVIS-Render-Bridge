# Fill these in Render Dashboard > Environment. Do not commit real secrets.
JARVIS_BDFD_TOKEN=generate-a-private-random-token-at-least-40-characters
JARVIS_PROVIDER_API_KEY=your-provider-api-key
JARVIS_PROVIDER_MODEL=provider/model-id
JARVIS_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
JARVIS_PROVIDER_NAME=OpenRouter
JARVIS_PROVIDER_ID=openrouter
JARVIS_PROVIDER_KIND=openai
JARVIS_PERSISTENT_DIR=/tmp/jarvis-persistent
JARVIS_GATEWAY_DIR=/tmp/jarvis-gateway
